        <mxCell id="R01" value="" edge="1" parent="1" source="refund_initial" target="awaiting" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#37474F;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=1;entryPerimeter=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="R01_label" value="observe refund candidate" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#ffffff;fontFamily=Arial;fontSize=14;">
          <mxGeometry x="35" y="175" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="R02" value="" edge="1" parent="1" source="awaiting" target="processing" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#37474F;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=1;entryPerimeter=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="R02_label" value="receiptAndCauseConfirmed&lt;br&gt;[paid goods AND complete return&lt;br&gt;AND cause confirmed; no duplicate]&lt;br&gt;/ refund original allocations by policy" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#ffffff;fontFamily=Arial;fontSize=14;">
          <mxGeometry x="415" y="165" width="320" height="115" as="geometry" />
        </mxCell>
        <mxCell id="R03" value="" edge="1" parent="1" source="processing" target="completed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#37474F;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=1;entryPerimeter=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="R03_label" value="refundSettlementConfirmed&lt;br&gt;/ record actual completed refund" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#ffffff;fontFamily=Arial;fontSize=14;">
          <mxGeometry x="1070" y="220" width="310" height="90" as="geometry" />
        </mxCell>
        <mxCell id="R04" value="" edge="1" parent="1" source="processing" target="unresolved" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#37474F;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=1;entryPerimeter=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="R04_label" value="refundRejected OR&lt;br&gt;settlementUncertain&lt;br&gt;/ do not mark refund completed" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#ffffff;fontFamily=Arial;fontSize=14;">
          <mxGeometry x="1080" y="470" width="330" height="115" as="geometry" />
        </mxCell>
        <mxCell id="rules" value="&lt;b&gt;Confirmed policy&lt;/b&gt;&lt;br&gt;Eligibility: paid goods + complete warehouse receipt + confirmed cause determining fee liability; no quality-inspection wait.&lt;br&gt;Product fault: refund original captured goods and shipping. Deliberate refusal: refund goods only; retain paid shipping.&lt;br&gt;Unpaid deliberate refusal: customer owes shipping directly to the delivery agent; shipping-only collection is not goods Paid." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#ffffff;fontFamily=Arial;fontSize=17;">
          <mxGeometry x="85" y="865" width="1710" height="130" as="geometry" />
        </mxCell>
        <mxCell id="financial" value="&lt;b&gt;Financial representation for review&lt;/b&gt;&lt;br&gt;Before confirmed settlement, do not claim a completed refund. Record captured, refunded and retained amounts separately.&lt;br&gt;If refunded amount is below the original captured amount, Partially Refunded is the proposed financial state.&lt;br&gt;Use Refunded only for the full captured amount. Payout provider/API, partial returns and retry policy remain TBD." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#ffffff;fontFamily=Arial;fontSize=16;">
          <mxGeometry x="85" y="1000" width="1710" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
