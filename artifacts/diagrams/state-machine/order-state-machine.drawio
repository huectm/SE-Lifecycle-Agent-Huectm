        </mxCell>
        <mxCell id="P04_label" value="refundSettlementConfirmed&lt;br&gt;[cumulative refund = captured]&lt;br&gt;/ record full refunded amount" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#ffffff;fontFamily=Arial;fontSize=14;">
          <mxGeometry x="990" y="530" width="330" height="65" as="geometry" />
        </mxCell>
        <mxCell id="payment_notes" value="&lt;b&gt;Modeling boundaries&lt;/b&gt;&lt;br&gt;Verified checkout payment selects Pending Paid directly. Later payment never implies Pending Unpaid -&gt; Pending Paid.&lt;br&gt;During refund Processing or Failed/Uncertain, do not falsely claim that money has been refunded.&lt;br&gt;Partially Refunded is a proposed addition to the existing dictionary and needs model approval before implementation.&lt;br&gt;Product fault refunds captured goods and shipping. Deliberate refusal retains the delivery fee and usually settles partially.&lt;br&gt;Shipping-only cash collection does not mark goods Paid. Unclassified/other causes, partial payments and outgoing integration remain TBD." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#ffffff;fontFamily=Arial;fontSize=17;">
          <mxGeometry x="90" y="780" width="1700" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
