        <mxCell id="claim" value="&lt;b&gt;checkout_idempotency (new)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Checkout request identity&lt;br&gt;One stored result per customer + operation + key&lt;br&gt;One checkout reference per customer + operation&lt;br&gt;Atomic with stock, order, lines and cart&lt;br&gt;Same key + changed request: reject" vertex="1" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fontFamily=Arial;fontSize=21;fillColor=#E8F5E9;strokeColor=#455A64;">
