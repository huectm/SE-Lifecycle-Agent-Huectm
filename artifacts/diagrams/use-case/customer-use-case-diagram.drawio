          <mxGeometry x="780" y="660" width="200" height="55" as="geometry"/>
        </mxCell>

        <!-- Extension UC: Feedback & Review -->
        <mxCell id="uc_ext_feedback" value="Rate &amp;amp; Review Order&#10;(Đánh giá &amp;amp; Phản hồi đơn hàng)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;fontColor=#1B5E20;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="735" width="200" height="55" as="geometry"/>
        </mxCell>

        <!-- Extension UC: Reorder Items -->
        <mxCell id="uc_ext_reorder" value="Re-order From Past Order&#10;(Đặt lại hàng từ đơn cũ)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;fontColor=#1B5E20;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="810" width="200" height="55" as="geometry"/>
        </mxCell>

        <!-- UC-C05: Manage Profile & Addresses -->
        <mxCell id="uc_profile" value="UC-C05: Manage Profile &amp;amp; Addresses&#10;(Quản lý thông tin &amp;amp; Sổ địa chỉ nhận hàng)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#388E3C;fontColor=#1B5E20;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="870" width="250" height="70" as="geometry"/>
        </mxCell>

        <!-- ================= DIRECTED ASSOCIATIONS (KARL WIEGERS CONVENTION) ================= -->
        <!-- Primary Actor (Guest) -> Use Cases -->
        <mxCell id="e_guest_news" style="endArrow=classic;endSize=8;html=1;rounded=0;strokeWidth=1.8;strokeColor=#2E7D32;" edge="1" parent="1" source="act_guest" target="uc_news">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_guest_browse" style="endArrow=classic;endSize=8;html=1;rounded=0;strokeWidth=1.8;strokeColor=#2E7D32;" edge="1" parent="1" source="act_guest" target="uc_browse">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_guest_cart" style="endArrow=classic;endSize=8;html=1;rounded=0;strokeWidth=1.8;strokeColor=#2E7D32;" edge="1" parent="1" source="act_guest" target="uc_cart">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_guest_auth" style="endArrow=classic;endSize=8;html=1;rounded=0;strokeWidth=1.8;strokeColor=#2E7D32;" edge="1" parent="1" source="act_guest" target="uc_auth">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Primary Actor (Customer) -> Use Cases -->
        <mxCell id="e_cust_checkout" style="endArrow=classic;endSize=8;html=1;rounded=0;strokeWidth=2;strokeColor=#1B5E20;" edge="1" parent="1" source="act_customer" target="uc_checkout">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_cust_orders" style="endArrow=classic;endSize=8;html=1;rounded=0;strokeWidth=2;strokeColor=#1B5E20;" edge="1" parent="1" source="act_customer" target="uc_orders">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_cust_profile" style="endArrow=classic;endSize=8;html=1;rounded=0;strokeWidth=2;strokeColor=#1B5E20;" edge="1" parent="1" source="act_customer" target="uc_profile">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Use Cases -> Support Actors (Directed solid lines) -->
        <mxCell id="e_auth_oauth" style="endArrow=classic;endSize=8;html=1;rounded=0;strokeWidth=1.8;strokeColor=#424242;" edge="1" parent="1" source="uc_auth" target="act_oauth">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_verify_sms" style="endArrow=classic;endSize=8;html=1;rounded=0;strokeWidth=1.8;strokeColor=#424242;" edge="1" parent="1" source="uc_ext_verify" target="act_sms">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_checkout_payment" style="endArrow=classic;endSize=8;html=1;rounded=0;strokeWidth=1.8;strokeColor=#424242;" edge="1" parent="1" source="uc_checkout" target="act_payment">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_checkout_mail" style="endArrow=classic;endSize=8;html=1;rounded=0;strokeWidth=1.8;strokeColor=#424242;" edge="1" parent="1" source="uc_checkout" target="act_mail">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ================= USE CASE RELATIONSHIPS (INCLUDE & EXTEND) ================= -->
        <!-- Checkout includes Customer Authentication -->
        <mxCell id="inc_checkout_auth" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;endArrow=open;endSize=8;dashed=1;rounded=0;strokeColor=#8E24AA;strokeWidth=1.5;fontSize=11;fontColor=#4A148C;" edge="1" parent="1" source="uc_checkout" target="uc_auth">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Verify OTP extends Customer Authentication -->
        <mxCell id="ext_verify_auth" value="&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;&#10;(First-time login)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;endArrow=open;endSize=8;dashed=1;rounded=0;strokeColor=#8E24AA;strokeWidth=1.4;fontSize=10;fontColor=#4A148C;" edge="1" parent="1" source="uc_ext_verify" target="uc_auth">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Extensions for Manage My Orders -->
        <mxCell id="ext_cancel_orders" value="&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;endArrow=open;endSize=8;dashed=1;rounded=0;strokeColor=#2E7D32;strokeWidth=1.4;fontSize=10;fontColor=#1B5E20;" edge="1" parent="1" source="uc_ext_cancel" target="uc_orders">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="ext_feedback_orders" value="&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;endArrow=open;endSize=8;dashed=1;rounded=0;strokeColor=#2E7D32;strokeWidth=1.4;fontSize=10;fontColor=#1B5E20;" edge="1" parent="1" source="uc_ext_feedback" target="uc_orders">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="ext_reorder_orders" value="&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;endArrow=open;endSize=8;dashed=1;rounded=0;strokeColor=#2E7D32;strokeWidth=1.4;fontSize=10;fontColor=#1B5E20;" edge="1" parent="1" source="uc_ext_reorder" target="uc_orders">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ================= EXPLANATORY NOTE BOX ================= -->
        <mxCell id="c_note_conventions" value="&amp;lt;b&amp;gt;Quy chuẩn Mô hình hóa (Karl Wiegers Convention):&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;1. &amp;lt;b&amp;gt;Directed Association (Đường nét liền):&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;   - &amp;lt;b&amp;gt;Primary Actor &amp;rarr; Use Case:&amp;lt;/b&amp;gt; Mũi tên từ tác nhân chính trỏ đến ca sử dụng (Guest/Customer chủ động khởi phát giao dịch).&amp;lt;br&amp;gt;   - &amp;lt;b&amp;gt;Use Case &amp;rarr; Support Actor:&amp;lt;/b&amp;gt; Mũi tên từ ca sử dụng trỏ đến hệ thống hỗ trợ bên thứ ba (OAuth Provider, SMS Gateway, Cổng QR SePay, Mail Service).&amp;lt;br&amp;gt;2. &amp;lt;b&amp;gt;Generalization (Thừa kế tác nhân):&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;   - Customer kế thừa Guest (Customer có đầy đủ quyền xem, tìm kiếm, giỏ hàng của Guest, đồng thời có thêm quyền Đặt hàng, Xem đơn, Hồ sơ).&amp;lt;br&amp;gt;3. &amp;lt;b&amp;gt;Mối quan hệ giữa các Use Case (Nét đứt):&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;   - &amp;lt;b&amp;gt;&amp;lt;&amp;lt;include&amp;gt;&amp;gt;:&amp;lt;/b&amp;gt; Đặt hàng (Checkout) bắt buộc bao gồm Đăng nhập xác thực.&amp;lt;br&amp;gt;   - &amp;lt;b&amp;gt;&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;:&amp;lt;/b&amp;gt; Mũi tên từ Ca sử dụng mở rộng trỏ về Ca sử dụng cơ sở." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF9C4;strokeColor=#FBC02D;fontSize=10.5;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="760" width="260" height="210" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
