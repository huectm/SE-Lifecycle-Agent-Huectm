        <mxCell id="act_oauth" value="&amp;lt;&amp;lt;Support Actor&amp;gt;&amp;gt;&#10;Google / Facebook&#10;(OAuth 2.0 Provider)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#F5F5F5;strokeColor=#616161;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1140" y="360" width="55" height="95" as="geometry"/>
