<mxCell id="owner_rule_note" value="* Thẩm quyền: Chỉ Store Owner có quyền tạo tài khoản nhân viên và thu hồi quyền truy cập (khóa tài khoản)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontStyle=2;fontColor=#D84315;" vertex="1" parent="1"><mxGeometry x="690" y="145" width="410" height="36" as="geometry"/></mxCell>
