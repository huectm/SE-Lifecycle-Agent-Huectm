<mxCell id="e_om11_ext5" value="&amp;lt;&amp;lt;extend&amp;gt;&amp;gt; [Export]" style="html=1;labelBackgroundColor=#FFFFFF;endArrow=open;endSize=7;dashed=1;rounded=0;strokeWidth=1.3;fontSize=8.5;strokeColor=#D84315;fontColor=#BF360C;" edge="1" parent="1" source="uc_owner_m11_5" target="uc_owner_m11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="inherited_box" value="NGUYÊN LÝ KẾ THỪA VAI TRÒ TRONG UML (ACTOR GENERALIZATION):&lt;br&gt;• Chủ cửa hàng (Store Owner) kế thừa toàn bộ quyền hạn và Use Cases của NV Bán hàng (Sale Staff) và NV Quản lý Kho (WH Staff).&lt;br&gt;• Theo chuẩn IEEE &amp;amp; Karl Wiegers: Không vẽ lại toàn bộ các Use Case con đã kế thừa nhằm tránh trùng lặp dư thừa.&lt;br&gt;• Store Owner có thể thực hiện mọi tác vụ: Xử lý đơn hàng (M01-M03), Biên tập tin tức (M04), Quản lý SP &amp;amp; Kho (M05-M10)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#FBC02D;fontSize=10;align=left;spacingLeft=12;fontColor=#5D4037;" vertex="1" parent="1"><mxGeometry x="190" y="500" width="910" height="80" as="geometry"/></mxCell>
<mxCell id="inh_sale_card" value="Chức năng kế thừa từ Sale Staff:&lt;br&gt;- UC-M01: Xử lý đơn hàng &amp;amp; Xác nhận&lt;br&gt;- UC-M02: In hóa đơn &amp;amp; Phiếu đóng gói&lt;br&gt;- UC-M03: Điều phối &amp;amp; Báo cáo giao hàng&lt;br&gt;- UC-M04: Biên tập &amp;amp; Quản lý bài viết" style="shape=rect;fillColor=#E3F2FD;strokeColor=#90CAF9;dashed=1;rounded=0;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=9.5;fontColor=#0D47A1;" vertex="1" parent="1"><mxGeometry x="190" y="600" width="440" height="125" as="geometry"/></mxCell>
<mxCell id="inh_wh_card" value="Chức năng kế thừa từ WH Staff:&lt;br&gt;- UC-M05: Quản lý danh mục loại SP&lt;br&gt;- UC-M06: Quản lý thông tin sản phẩm&lt;br&gt;- UC-M07: Quản lý nhà cung cấp&lt;br&gt;- UC-M08: Quản lý nhập kho &amp;amp; Hóa đơn&lt;br&gt;- UC-M09 &amp;amp; M10: Tồn kho theo lô &amp;amp; Hủy hàng" style="shape=rect;fillColor=#FFE0B2;strokeColor=#FFB74D;dashed=1;rounded=0;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=9.5;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="660" y="600" width="440" height="125" as="geometry"/></mxCell>
<mxCell id="e_act_m13" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=1.5;strokeColor=#D84315;" edge="1" parent="1" source="act_owner" target="uc_m13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_act_om11" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=1.5;strokeColor=#D84315;" edge="1" parent="1" source="act_owner" target="uc_owner_m11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="owner_note" value="Quy chuẩn UML: 1. System Boundary góc vuông duy nhất. 2. Store Owner đóng vai trò Generalization kế thừa toàn bộ chức năng của Sale Staff và WH Staff." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#FBC02D;fontSize=9;align=left;spacingLeft=8;fontColor=#5D4037;" vertex="1" parent="1"><mxGeometry x="160" y="772" width="970" height="42" as="geometry"/></mxCell>
      </root>
