<mxCell id="sale_note" value="Quy chuẩn UML: 1. System Boundary góc vuông duy nhất, tác nhân Sale Staff bên ngoài phía trái, Support Actor (Printer) bên ngoài phía phải.&lt;br&gt;2. Áp dụng chuẩn quan hệ CRUD (Base UC include View List; Add/Edit/Delete/Hide extend Base UC)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#FBC02D;fontSize=9;align=left;spacingLeft=8;fontColor=#5D4037;" vertex="1" parent="1"><mxGeometry x="160" y="772" width="875" height="42" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="store-owner-tab" name="7. Decomposed - Store Owner (Single Boundary)"><mxGraphModel dx="1169" dy="827" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" />
