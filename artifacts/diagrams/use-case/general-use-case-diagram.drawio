        <mxCell id="h_gen_owner_wh" value="&amp;lt;&amp;lt;generalizes&amp;gt;&amp;gt;" style="endArrow=block;endFill=0;endSize=12;html=1;rounded=0;strokeColor=#D32F2F;strokeWidth=1.8;edgeStyle=orthogonalEdgeStyle;fontSize=10;fontColor=#B71C1C;" edge="1" parent="1" source="h_owner" target="h_wh">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        
        <mxCell id="h_note" value="&amp;lt;b&amp;gt;Ý nghĩa Nghiệp vụ của Cây Kế thừa Tác nhân:&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;1. &amp;lt;b&amp;gt;Customer &amp;rarr; Guest:&amp;lt;/b&amp;gt; Khách hàng thành viên có mọi quyền của Khách vãng lai (xem/tìm kiếm sản phẩm, đọc bài viết dinh dưỡng, thêm giỏ hàng) và được mở rộng thêm quyền Đặt hàng (Checkout), Quản lý đơn hàng (Xem đơn, Hủy, Đánh giá, Đặt lại), và Quản lý hồ sơ/sổ địa chỉ.&amp;lt;br&amp;gt;2. &amp;lt;b&amp;gt;Store Owner &amp;rarr; Sale Staff &amp;amp; WH Staff:&amp;lt;/b&amp;gt; Chủ cửa hàng kế thừa toàn bộ chức năng của Nhân viên bán hàng và Nhân viên quản lý kho. Khi nhân viên bận hoặc vắng mặt, chủ cửa hàng có thể thực hiện mọi thao tác của nhân viên.&amp;lt;br&amp;gt;3. &amp;lt;b&amp;gt;Quyền đặc thù của Store Owner:&amp;lt;/b&amp;gt; Quản lý tài khoản nhân viên (tạo mới tài khoản, phân quyền, thu hồi quyền khi thôi việc) và Tra cứu nhật ký kiểm toán giao dịch (Audit Logs)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF9C4;strokeColor=#FBC02D;fontSize=11;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="650" width="580" height="150" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

<diagram id="decomposed-wh-staff-diag" name="5. Decomposed - WH Staff (Single System Boundary)">
    <mxGraphModel dx="1540" dy="540" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root><mxCell id="0" /><mxCell id="1" parent="0" />
<mxCell id="diag_title" value="DECOMPOSED USE CASE DIAGRAM — WAREHOUSE STAFF (NHÂN VIÊN QUẢN LÝ KHO)&lt;br&gt;Biểu đồ phân rã Use Case trong System Boundary duy nhất — Bố cục chuẩn A4 Landscape (1169 x 827 px)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12.5;fontStyle=1;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="35" y="10" width="1100" height="38" as="geometry" /></mxCell>
