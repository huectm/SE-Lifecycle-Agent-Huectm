<mxCell id="e_act_om11" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=1.5;strokeColor=#D84315;" edge="1" parent="1" source="act_owner" target="uc_owner_m11"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="owner_note" value="Quy chuẩn UML: 1. System Boundary góc vuông duy nhất. 2. Store Owner đóng vai trò Generalization kế thừa toàn bộ chức năng của Sale Staff và WH Staff." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#FBC02D;fontSize=9;align=left;spacingLeft=8;fontColor=#5D4037;" vertex="1" parent="1"><mxGeometry x="160" y="772" width="970" height="42" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>