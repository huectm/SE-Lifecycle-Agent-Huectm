        <mxCell id="c_note_extend" value="&amp;lt;b&amp;gt;Quy chuẩn Mô hình hóa &amp;lt;&amp;lt;extend&amp;gt;&amp;gt;:&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;1. &amp;lt;b&amp;gt;Base Use Cases:&amp;lt;/b&amp;gt; &amp;lt;i&amp;gt;Đăng nhập, Đăng xuất, Xem thông tin cá nhân&amp;lt;/i&amp;gt; là các ca sử dụng độc lập, hoàn chỉnh, kết nối trực tiếp với tác nhân &amp;lt;b&amp;gt;User&amp;lt;/b&amp;gt;.&amp;lt;br&amp;gt;2. &amp;lt;b&amp;gt;Extension Use Cases:&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;- &amp;lt;b&amp;gt;Quên mật khẩu&amp;lt;/b&amp;gt; extend từ &amp;lt;b&amp;gt;Đăng nhập&amp;lt;/b&amp;gt; (khi người dùng không nhớ mật khẩu tại form login).&amp;lt;br&amp;gt;- &amp;lt;b&amp;gt;Cập nhật thông tin&amp;lt;/b&amp;gt; và &amp;lt;b&amp;gt;Đổi mật khẩu&amp;lt;/b&amp;gt; extend từ &amp;lt;b&amp;gt;Xem thông tin cá nhân&amp;lt;/b&amp;gt; (chỉ kích hoạt tùy chọn tại màn hình hồ sơ).&amp;lt;br&amp;gt;3. &amp;lt;b&amp;gt;Hướng mũi tên:&amp;lt;/b&amp;gt; Chuẩn UML nét đứt từ Extension UC trỏ về Base UC." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF9C4;strokeColor=#FBC02D;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          
          
          <mxGeometry x="40" y="740" width="270" height="145" as="geometry"/>
          
        
        </mxCell>
        
      
