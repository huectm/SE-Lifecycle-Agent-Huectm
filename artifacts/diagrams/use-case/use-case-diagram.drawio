        <mxCell id="e_sms_link" style="endArrow=classic;endSize=7;html=1;rounded=0;strokeWidth=1.5;strokeColor=#616161;dashed=1;" edge="1" parent="1" source="uc_ext_verify" target="c_act_sms">
          
          
