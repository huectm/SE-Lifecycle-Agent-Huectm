        <mxCell id="CheckoutController" value="&lt;div style=&quot;font-size:13px;text-align:center&quot;&gt;&lt;b&gt;&amp;lt;&amp;lt;controller&amp;gt;&amp;gt;&lt;br&gt;CheckoutController&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:23px&quot;&gt;- service: ICheckoutService&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:23px&quot;&gt;+ CheckoutController(service: ICheckoutService)&lt;br&gt;+ PrepareCheckoutAsync(request: CheckoutInputDto):&lt;br&gt;CheckoutSummaryDto&lt;br&gt;+ PlaceOrderAsync(request: PlaceOrderDto): OrderConfirmationDto&lt;br&gt;+ CreatePaymentQrAsync(request: PaymentQrRequestDto):&lt;br&gt;PaymentQrDto&lt;/div&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#E8F1FA;strokeColor=#455A64;">
