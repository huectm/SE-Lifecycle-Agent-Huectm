        <mxCell id="CheckoutPage" value="&lt;div style=&quot;font-size:13px;text-align:center&quot;&gt;&lt;b&gt;&amp;lt;&amp;lt;boundary&amp;gt;&amp;gt;&lt;br&gt;CheckoutPage&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:23px&quot;&gt;- api: CheckoutApiClient&lt;br&gt;- state: CheckoutSummaryDto?&lt;br&gt;- isBusy: Boolean&lt;br&gt;- errorCode: Text?&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:23px&quot;&gt;+ Render(): View&lt;br&gt;+ OnPrepareCheckoutAsync(request: CheckoutInputDto): Void&lt;br&gt;+ OnPlaceOrderAsync(request: PlaceOrderDto): Void&lt;br&gt;+ OnCreatePaymentQrAsync(request: PaymentQrRequestDto): Void&lt;br&gt;+ OnPaymentStateChanged(result: PaymentResultDto): Void&lt;/div&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#F3E5F5;strokeColor=#455A64;">
