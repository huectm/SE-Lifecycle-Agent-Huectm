  <diagram id="bp01-goods-receipt-activity" name="BP01 Goods Receipt Activity Diagram">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- DIAGRAM HEADER TITLE -->
        <mxCell id="title" value="BIỂU ĐỒ HOẠT ĐỘNG (ACTIVITY DIAGRAM) — QUY TRÌNH NHẬP KHO &amp; QUẢN LÝ LÔ HÀNG (BP-01)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="120" y="15" width="920" height="30" as="geometry"/>
        </mxCell>

        <!-- SWIMLANE 1: SUPPLIER -->
        <mxCell id="lane_supplier" value="Nhà cung cấp (Supplier)&#10;[External Partner]" style="swimlane;html=1;childLayout=stackLayout;resizeParent=1;resizeParentMax=0;startSize=40;horizontal=1;horizontalFlip=0;fillColor=#FFF3E0;strokeColor=#FB8C00;fontColor=#E65100;fontSize=12;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="260" height="645" as="geometry"/>
        </mxCell>

        <!-- SWIMLANE 2: WAREHOUSE STAFF -->
        <mxCell id="lane_wh_staff" value="Nhân viên Kho (Warehouse Staff)&#10;[Primary Operational Role]" style="swimlane;html=1;childLayout=stackLayout;resizeParent=1;resizeParentMax=0;startSize=40;horizontal=1;horizontalFlip=0;fillColor=#E8F5E9;strokeColor=#43A047;fontColor=#1B5E20;fontSize=12;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="300" y="55" width="450" height="645" as="geometry"/>
        </mxCell>

        <!-- SWIMLANE 3: FRESHFOOD SYSTEM -->
        <mxCell id="lane_system" value="Hệ thống FreshFood (System)&#10;[Automated Processing &amp; Inventory]" style="swimlane;html=1;childLayout=stackLayout;resizeParent=1;resizeParentMax=0;startSize=40;horizontal=1;horizontalFlip=0;fillColor=#E3F2FD;strokeColor=#1E88E5;fontColor=#0D47A1;fontSize=12;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="750" y="55" width="370" height="645" as="geometry"/>
        </mxCell>

        <!-- ================= NODES ================= -->

        <!-- Initial Node (Start) -->
        <mxCell id="init_node" value="" style="ellipse;fillColor=#1B5E20;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="158" y="115" width="24" height="24" as="geometry"/>
        </mxCell>

        <!-- Activity 1: Deliver Goods (Supplier) -->
        <mxCell id="act_deliver" value="Giao hàng &amp; Chứng từ hóa đơn&#10;(Deliver Goods &amp; Invoice)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#FB8C00;fontColor=#000000;fontSize=11;fontStyle=1;arcSize=25;" vertex="1" parent="1">
          <mxGeometry x="75" y="165" width="190" height="50" as="geometry"/>
        </mxCell>

        <!-- Activity 2: Inspect Goods (WH Staff) -->
        <mxCell id="act_inspect" value="Kiểm đếm hàng thực tế &amp; Hạn sử dụng&#10;(Inspect Physical Goods &amp; Expiry)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#388E3C;fontColor=#000000;fontSize=11;fontStyle=1;arcSize=25;" vertex="1" parent="1">
          <mxGeometry x="415" y="165" width="220" height="50" as="geometry"/>
        </mxCell>

        <!-- Decision 1: Goods Qualified? (WH Staff) -->
        <mxCell id="dec_qualified" value="Hàng đạt&#10;chuẩn?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#FBC02D;fontColor=#000000;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="245" width="110" height="60" as="geometry"/>
        </mxCell>

        <!-- Rejection Flow: Return to Supplier -->
        <mxCell id="act_reject" value="Lập biên bản từ chối&#10;&amp; Trả lại hàng cho NCC&#10;(Reject &amp; Issue Return Note)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#E53935;fontColor=#B71C1C;fontSize=11;fontStyle=1;arcSize=25;" vertex="1" parent="1">
          <mxGeometry x="85" y="250" width="180" height="50" as="geometry"/>
        </mxCell>

        <!-- Final State Rejection -->
        <mxCell id="end_rejected" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#D32F2F;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="325" width="24" height="24" as="geometry"/>
        </mxCell>

        <!-- Activity 3: Record Goods Receipt (WH Staff) -->
        <mxCell id="act_record_receipt" value="Lập &amp; Xác nhận Phiếu nhập kho&#10;(Record &amp; Confirm Goods Receipt)&#10;[Áp dụng UC-M08.2]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#388E3C;fontColor=#000000;fontSize=11;fontStyle=1;arcSize=25;" vertex="1" parent="1">
          <mxGeometry x="415" y="340" width="220" height="55" as="geometry"/>
        </mxCell>

        <!-- Activity 4: Update Batch Inventory & Cost (System) -->
        <mxCell id="act_update_inventory" value="Cập nhật Tồn kho theo từng Lô&#10;&amp; Ghi nhận Giá vốn&#10;(Update Batch Stock &amp; Cost Price)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;fontColor=#000000;fontSize=11;fontStyle=1;arcSize=25;" vertex="1" parent="1">
          <mxGeometry x="825" y="340" width="220" height="55" as="geometry"/>
        </mxCell>

        <!-- Activity 5: Set Price by Batch (WH Staff) -->
        <mxCell id="act_set_price" value="Thiết lập Giá bán lẻ cho Lô mới&#10;(Set Retail Price by Batch)&#10;[Áp dụng UC-M09.2]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#388E3C;fontColor=#000000;fontSize=11;fontStyle=1;arcSize=25;" vertex="1" parent="1">
          <mxGeometry x="415" y="440" width="220" height="50" as="geometry"/>
        </mxCell>

        <!-- Decision 2: Old Batch Exists? (System) -->
        <mxCell id="dec_old_batch" value="Còn lô cũ&#10;cùng loại&#10;trong kho?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#FBC02D;fontColor=#000000;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="435" width="110" height="60" as="geometry"/>
        </mxCell>

        <!-- Activity 6A: Hold New Batch / Discount Old Batch -->
        <mxCell id="act_fifo_strategy" value="Hoãn bán lô mới (FIFO)&#10;hoặc Giảm giá lô cũ cận date&#10;(Hold New Batch or Discount Old Batch)&#10;[Áp dụng UC-M09.3, UC-M09.4]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;fontColor=#000000;fontSize=11;fontStyle=1;arcSize=25;" vertex="1" parent="1">
          <mxGeometry x="765" y="535" width="215" height="55" as="geometry"/>
        </mxCell>

        <!-- Activity 6B: Activate New Batch for Sale -->
        <mxCell id="act_activate_sale" value="Kích hoạt Mở bán ngay&#10;lô hàng mới trên Website&#10;(Activate New Batch for Sale)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;fontColor=#000000;fontSize=11;fontStyle=1;arcSize=25;" vertex="1" parent="1">
          <mxGeometry x="995" y="535" width="115" height="55" as="geometry"/>
        </mxCell>

        <!-- Merge Node -->
        <mxCell id="merge_end" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#FBC02D;" vertex="1" parent="1">
          <mxGeometry x="915" y="615" width="30" height="25" as="geometry"/>
        </mxCell>

        <!-- Final State Success -->
        <mxCell id="end_success" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="918" y="660" width="24" height="24" as="geometry"/>
        </mxCell>


        <!-- ================= TRANSITIONS (EDGES) ================= -->

        <!-- Start -> Deliver -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#37474F;strokeWidth=1.5;" edge="1" source="init_node" target="act_deliver" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Deliver -> Inspect -->
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#37474F;strokeWidth=1.5;" edge="1" source="act_deliver" target="act_inspect" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Inspect -> Decision Qualified -->
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#37474F;strokeWidth=1.5;" edge="1" source="act_inspect" target="dec_qualified" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Decision Qualified -> [Không đạt] -> Reject -->
        <mxCell id="e4" value="[Không / No]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D32F2F;strokeWidth=1.5;fontColor=#B71C1C;fontSize=10;fontStyle=1;" edge="1" source="dec_qualified" target="act_reject" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Reject -> End Rejected -->
        <mxCell id="e4_end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D32F2F;strokeWidth=1.5;" edge="1" source="act_reject" target="end_rejected" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Decision Qualified -> [Đạt chuẩn] -> Record Receipt -->
        <mxCell id="e5" value="[Đạt chuẩn / Yes]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D32;strokeWidth=1.5;fontColor=#1B5E20;fontSize=10;fontStyle=1;" edge="1" source="dec_qualified" target="act_record_receipt" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Record Receipt -> Update Inventory -->
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#37474F;strokeWidth=1.5;" edge="1" source="act_record_receipt" target="act_update_inventory" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Update Inventory -> Set Price by Batch -->
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#37474F;strokeWidth=1.5;" edge="1" source="act_update_inventory" target="act_set_price" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="935" y="415"/>
              <mxPoint x="525" y="415"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Set Price -> Decision Old Batch -->
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#37474F;strokeWidth=1.5;" edge="1" source="act_set_price" target="dec_old_batch" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Decision Old Batch -> [Có / Yes] -> FIFO Strategy -->
        <mxCell id="e9" value="[Có / Yes]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#37474F;strokeWidth=1.5;fontColor=#0D47A1;fontSize=10;fontStyle=1;" edge="1" source="dec_old_batch" target="act_fifo_strategy" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Decision Old Batch -> [Không / No] -> Activate Sale -->
        <mxCell id="e10" value="[Không / No]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#37474F;strokeWidth=1.5;fontColor=#0D47A1;fontSize=10;fontStyle=1;" edge="1" source="dec_old_batch" target="act_activate_sale" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- FIFO Strategy -> Merge End -->
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#37474F;strokeWidth=1.5;" edge="1" source="act_fifo_strategy" target="merge_end" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Activate Sale -> Merge End -->
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#37474F;strokeWidth=1.5;" edge="1" source="act_activate_sale" target="merge_end" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Merge End -> End Success -->
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D32;strokeWidth=1.5;" edge="1" source="merge_end" target="end_success" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

