        </mxCell>
        <mxCell id="ProfilePage" value="&lt;div style=&quot;font-size:13px;text-align:center&quot;&gt;&lt;b&gt;&amp;lt;&amp;lt;boundary&amp;gt;&amp;gt;&lt;br&gt;ProfilePage&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:23px&quot;&gt;- api: ProfileApiClient&lt;br&gt;- state: ProfileResultDto?&lt;br&gt;- isBusy: boolean&lt;br&gt;- errorCode: string?&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:23px&quot;&gt;+ Render(): ReactNode&lt;br&gt;+ OnGetProfileAsync(): Promise&amp;lt;void&amp;gt;&lt;br&gt;+ OnUpdateProfileAsync(request: ProfileUpdateDto): Promise&amp;lt;void&amp;gt;&lt;br&gt;+ OnSaveAddressAsync(request: AddressInputDto): Promise&amp;lt;void&amp;gt;&lt;br&gt;+ OnSetDefaultAddressAsync(addressId: EntityId): Promise&amp;lt;void&amp;gt;&lt;br&gt;+ OnDeleteAddressAsync(addressId: EntityId): Promise&amp;lt;void&amp;gt;&lt;/div&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#F3E5F5;strokeColor=#455A64;">
          <mxGeometry x="120" y="190" width="680" height="415" as="geometry" />
        </mxCell>
        <mxCell id="ProfileController" value="&lt;div style=&quot;font-size:13px;text-align:center&quot;&gt;&lt;b&gt;&amp;lt;&amp;lt;controller&amp;gt;&amp;gt;&lt;br&gt;ProfileController&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:23px&quot;&gt;- service: IProfileService&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:23px&quot;&gt;+ ProfileController(service: IProfileService)&lt;br&gt;+ GetProfileAsync(signal: AbortSignal):&lt;br&gt;Promise&amp;lt;ProfileResultDto&amp;gt;&lt;br&gt;+ UpdateProfileAsync(request: ProfileUpdateDto, signal:&lt;br&gt;AbortSignal): Promise&amp;lt;ProfileResultDto&amp;gt;&lt;br&gt;+ SaveAddressAsync(request: AddressInputDto, signal:&lt;br&gt;AbortSignal): Promise&amp;lt;AddressDto&amp;gt;&lt;br&gt;+ SetDefaultAddressAsync(addressId: EntityId, signal:&lt;br&gt;AbortSignal): Promise&amp;lt;ProfileResultDto&amp;gt;&lt;br&gt;+ DeleteAddressAsync(addressId: EntityId, signal: AbortSignal):&lt;br&gt;Promise&amp;lt;OperationResultDto&amp;gt;&lt;/div&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#E8F1FA;strokeColor=#455A64;">
