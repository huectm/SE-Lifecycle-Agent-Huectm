        <mxCell id="ProfileApiClient" value="&lt;div style=&quot;font-size:13px;text-align:center&quot;&gt;&lt;b&gt;&amp;lt;&amp;lt;adapter&amp;gt;&amp;gt;&lt;br&gt;ProfileApiClient&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:23px&quot;&gt;- http: HttpTransport&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:23px&quot;&gt;+ GetProfileAsync(): Promise&amp;lt;ProfileResultDto&amp;gt;&lt;br&gt;+ UpdateProfileAsync(request: ProfileUpdateDto):&lt;br&gt;Promise&amp;lt;ProfileResultDto&amp;gt;&lt;br&gt;+ SaveAddressAsync(request: AddressInputDto):&lt;br&gt;Promise&amp;lt;AddressDto&amp;gt;&lt;br&gt;+ SetDefaultAddressAsync(addressId: EntityId):&lt;br&gt;Promise&amp;lt;ProfileResultDto&amp;gt;&lt;br&gt;+ DeleteAddressAsync(addressId: EntityId):&lt;br&gt;Promise&amp;lt;OperationResultDto&amp;gt;&lt;/div&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#E8F1FA;strokeColor=#455A64;">
