        <mxCell id="AcceptOrderTransition" value="&lt;div style=&quot;font-size:13px;text-align:center&quot;&gt;&lt;b&gt;&amp;lt;&amp;lt;transition&amp;gt;&amp;gt;&lt;br&gt;AcceptOrderTransition&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:23px&quot;&gt;+ Id: string = I00&lt;br&gt;+ Source: string = initial&lt;br&gt;+ Target: string = payment_choice&lt;br&gt;- repository: IOrderLifecycleRepository&lt;br&gt;- checkoutRepository: ICheckoutRepository&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:23px&quot;&gt;+ AcceptOrderTransition(orderLifecycleRepository:&lt;br&gt;IOrderLifecycleRepository, checkoutRepository:&lt;br&gt;ICheckoutRepository)&lt;br&gt;+ CanExecute(snapshot: TransitionSnapshot, command:&lt;br&gt;TransitionCommand): boolean&lt;br&gt;+ ExecuteAsync(snapshot: TransitionSnapshot, command:&lt;br&gt;TransitionCommand, signal: AbortSignal):&lt;br&gt;Promise&amp;lt;TransitionResult&amp;gt;&lt;/div&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#E3F2FD;strokeColor=#455A64;">
