        <mxCell id="Order" value="&lt;div style=&quot;font-size:13px;text-align:center&quot;&gt;&lt;b&gt;&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&lt;br&gt;Order&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:23px&quot;&gt;+ OrderId: EntityId {private set}&lt;br&gt;+ OrderNumber: string {private set}&lt;br&gt;+ CustomerId: EntityId {private set}&lt;br&gt;+ DeliveryAddressId: EntityId {private set}&lt;br&gt;+ ProcessedByStaffId: number {private set}&lt;br&gt;+ OrderDate: Date {private set}&lt;br&gt;+ SubTotal: VndAmount {private set}&lt;br&gt;+ DeliveryDistance: number {private set}&lt;br&gt;+ ShippingFee: VndAmount {private set}&lt;br&gt;+ TotalAmount: VndAmount {private set}&lt;br&gt;+ PaymentMethod: PaymentMethod {private set}&lt;br&gt;+ PaymentStatus: PaymentStatus {private set}&lt;br&gt;+ OrderStatus: OrderStatus {private set}&lt;br&gt;+ IsFirstOrder: boolean {private set}&lt;br&gt;+ DeliveryAgentId: EntityId {private set}&lt;br&gt;+ PhoneConfirmationStatus: string {private set}&lt;br&gt;+ PhoneContactedByStaffId: number {private set}&lt;br&gt;+ PhoneContactedAt: Date {private set}&lt;br&gt;+ PhoneConfirmationNote: string {private set}&lt;br&gt;+ CancellationReason: string {private set}&lt;br&gt;+ Details: ReadonlyArray&amp;lt;OrderDetail&amp;gt; {read only; materialized&lt;br&gt;navigation}&lt;br&gt;+ Customer: Customer {read only; materialized navigation}&lt;br&gt;+ DeliveryAddress: CustomerAddress {read only; materialized&lt;br&gt;navigation}&lt;br&gt;+ Payments: ReadonlyArray&amp;lt;OrderPayment&amp;gt; {read only; materialized&lt;br&gt;navigation}&lt;br&gt;+ Failure: DeliveryFailure? {read only; materialized navigation}&lt;br&gt;+ Return: ReturnReceipt? {read only; materialized navigation}&lt;br&gt;+ Refund: Refund? {read only; materialized navigation}&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:23px&quot;&gt;+ ApplyFulfillment(expected: OrderStatus, target: OrderStatus):&lt;br&gt;void&lt;br&gt;+ RecordPayment(expected: PaymentStatus, target: PaymentStatus):&lt;br&gt;void&lt;br&gt;+ Cancel(expected: OrderStatus, reason: string): void&lt;/div&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#F1F8E9;strokeColor=#455A64;">
