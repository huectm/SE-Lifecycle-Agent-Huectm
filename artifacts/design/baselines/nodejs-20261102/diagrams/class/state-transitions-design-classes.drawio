        <mxCell id="IOrderLifecycleRepository" value="&lt;div style=&quot;font-size:13px;text-align:center&quot;&gt;&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br&gt;IOrderLifecycleRepository&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:23px&quot;&gt;+ LockOrderAsync(orderId: EntityId, signal: AbortSignal):&lt;br&gt;Promise&amp;lt;Order&amp;gt;&lt;br&gt;+ LoadLifecycleAsync(orderId: EntityId, signal: AbortSignal):&lt;br&gt;Promise&amp;lt;OrderLifecycleRecords&amp;gt;&lt;br&gt;+ SaveAsync(order: Order, signal: AbortSignal): Promise&amp;lt;void&amp;gt;&lt;br&gt;+ RecordEventOnceAsync(aggregateId: EntityId, eventId: string,&lt;br&gt;transitionId: string, signal: AbortSignal): Promise&amp;lt;boolean&amp;gt;&lt;br&gt;+ SaveOrderLinesAsync(order: Order, lines:&lt;br&gt;ReadonlyArray&amp;lt;OrderDetail&amp;gt;, signal: AbortSignal): Promise&amp;lt;void&amp;gt;&lt;br&gt;+ SavePaymentOnceAsync(payment: OrderPayment, signal:&lt;br&gt;AbortSignal): Promise&amp;lt;boolean&amp;gt;&lt;br&gt;+ SaveFailureAsync(failure: DeliveryFailure, signal:&lt;br&gt;AbortSignal): Promise&amp;lt;void&amp;gt;&lt;br&gt;+ SaveReceiptAsync(receipt: ReturnReceipt, items:&lt;br&gt;ReadonlyArray&amp;lt;ReturnReceiptItem&amp;gt;, signal: AbortSignal):&lt;br&gt;Promise&amp;lt;void&amp;gt;&lt;br&gt;+ SaveRefundOnceAsync(refund: Refund, signal: AbortSignal):&lt;br&gt;Promise&amp;lt;boolean&amp;gt;&lt;br&gt;+ SaveShippingSettlementAsync(settlement: ShippingFeeSettlement,&lt;br&gt;signal: AbortSignal): Promise&amp;lt;void&amp;gt;&lt;br&gt;+ LockReservedBatchesAsync(orderId: EntityId, signal:&lt;br&gt;AbortSignal): Promise&amp;lt;ReadonlyArray&amp;lt;BatchInventory&amp;gt;&amp;gt;&lt;br&gt;+ SaveBatchesAsync(batches: ReadonlyArray&amp;lt;BatchInventory&amp;gt;,&lt;br&gt;signal: AbortSignal): Promise&amp;lt;void&amp;gt;&lt;br&gt;+ AppendAuditAsync(audit: AuditLog, signal: AbortSignal):&lt;br&gt;Promise&amp;lt;void&amp;gt;&lt;/div&gt;" vertex="1" parent="1" style="htm