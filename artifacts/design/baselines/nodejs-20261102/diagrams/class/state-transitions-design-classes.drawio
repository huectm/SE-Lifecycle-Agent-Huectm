        <mxCell id="OrderStateMachine" value="&lt;div style=&quot;font-size:13px;text-align:center&quot;&gt;&lt;b&gt;&amp;lt;&amp;lt;state machine&amp;gt;&amp;gt;&lt;br&gt;OrderStateMachine&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:23px&quot;&gt;- repository: IOrderLifecycleRepository&lt;br&gt;- transitionTable: ReadonlyArray&amp;lt;object&amp;gt; {private; read only}&lt;br&gt;- snapshot: TransitionSnapshot? {server trusted; request scoped}&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:23px&quot;&gt;+ OrderStateMachine(repository: IOrderLifecycleRepository)&lt;br&gt;+ processEvent(snapshot: TransitionSnapshot, event:&lt;br&gt;StateMachineEvent, signal: AbortSignal):&lt;br&gt;Promise&amp;lt;StateMachineResult&amp;gt;&lt;br&gt;+ currentState(): OrderStateSnapshot?&lt;/div&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#E8F1FA;strokeColor=#455A64;">
