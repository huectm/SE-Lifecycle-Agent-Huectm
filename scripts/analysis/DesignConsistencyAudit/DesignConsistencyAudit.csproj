<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <RoslynDir>$(MSBuildSDKsPath)/../DotnetTools/dotnet-format</RoslynDir>
    <SonarQubeExclude>true</SonarQubeExclude>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.Build.Locator" HintPath="$(RoslynDir)/Microsoft.Build.Locator.dll" />
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(RoslynDir)/Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(RoslynDir)/Microsoft.CodeAnalysis.CSharp.dll" />
    <Reference Include="Microsoft.CodeAnalysis.Workspaces" HintPath="$(RoslynDir)/Microsoft.CodeAnalysis.Workspaces.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" HintPath="$(RoslynDir)/Microsoft.CodeAnalysis.CSharp.Workspaces.dll" />
    <Reference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" HintPath="$(RoslynDir)/Microsoft.CodeAnalysis.Workspaces.MSBuild.dll" />
    <Reference Include="System.Composition.AttributedModel" HintPath="$(RoslynDir)/System.Composition.AttributedModel.dll" />
    <Reference Include="System.Composition.Runtime" HintPath="$(RoslynDir)/System.Composition.Runtime.dll" />
    <Reference Include="System.Composition.TypedParts" HintPath="$(RoslynDir)/System.Composition.TypedParts.dll" />
    <Reference Include="System.Composition.Hosting" HintPath="$(RoslynDir)/System.Composition.Hosting.dll" />
    <Reference Include="System.Composition.Convention" HintPath="$(RoslynDir)/System.Composition.Convention.dll" />
    <None Include="$(RoslynDir)/BuildHost-netcore/**" Link="BuildHost-netcore/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
